# Test-only environment. Points the DynamoDB client at DynamoDB Local.
# This file is loaded by test/e2e/setup/env.ts BEFORE the app imports dynamoClient.
DYNAMODB_TABLE_MAIN=trainee-2026-rifat-mhp-v2
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
NODE_ENV=test
PORT=0
# DISCORD_PUBLIC_KEY is generated at runtime from a test Ed25519 keypair in setup/env.ts.
# Role snowflakes are unused by the code under test (roles come from the DB profile),
# but kept for completeness.
DISCORD_ROLE_ADMIN=admin
DISCORD_ROLE_LEAD=lead
DISCORD_ROLE_LOGISTICS=logistics
DISCORD_ROLE_EMPLOYEE=employee
